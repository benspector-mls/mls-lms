{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(npm run db:deploy:deployment:*)",
      "Bash(npm run setup:storage:deployment:*)",
      "Bash(npx tsx scripts/with-deployment-env.ts npm run db:deploy:*)",
      "Bash(npx tsx scripts/with-deployment-env.ts npm run setup:storage:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/deployment-guard.mjs\"",
            "statusMessage": "Checking which database this touches"
          }
        ]
      }
    ]
  }
}
