// Prisma schema for mls-lms
//
// !! Use `prisma migrate deploy` — NEVER `prisma db push`. Push does not honor
// !! the external-table list and will try to drop Supabase's auth tables.
// !! See the comment block in prisma.config.ts.
//
// Identity lives in Supabase Auth (`auth.users`), which Supabase owns and
// migrates. Prisma treats it as an *external table*: it is declared here so
// relations and the client API work, but migrations never touch it. See
// `tables.external` in prisma.config.ts.
//
// Application-level user data belongs in `public.profiles`, which is 1:1 with
// `auth.users` and IS owned by Prisma.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

/// Supabase Auth's user table. EXTERNAL — managed by Supabase, not Prisma.
/// Only the columns this app reads are mapped; the real table has many more.
model AuthUser {
  id               String    @id @db.Uuid
  email            String?   @unique
  emailConfirmedAt DateTime? @map("email_confirmed_at") @db.Timestamptz(6)
  createdAt        DateTime? @map("created_at") @db.Timestamptz(6)

  profile Profile?

  @@map("users")
  @@schema("auth")
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN

  @@schema("public")
}

/// Application profile, 1:1 with auth.users. Owned by Prisma.
model Profile {
  /// Same value as auth.users.id — this is the FK *and* the PK.
  id                String   @id @db.Uuid
  // Nullable because auth.users.email is nullable (anonymous, phone, and some
  // OAuth signups have no email). A NOT NULL here would make the on-signup
  // trigger throw and break signup entirely.
  email             String?  @unique
  displayName       String?  @map("display_name")
  avatarUrl         String?  @map("avatar_url")
  /// GitHub login handle, populated on GitHub OAuth signup. Unique so one
  /// GitHub account maps to at most one profile. Nullable: email signups have
  /// none, and Postgres permits many NULLs under a unique constraint.
  githubUsername    String?  @unique @map("github_username")
  /// GitHub's numeric user ID — the DURABLE identity key. A user can rename
  /// their GitHub account, which changes githubUsername but never this. Use
  /// this for identity; use githubUsername only where GitHub's API needs a
  /// login string (repository naming, collaborator invitations).
  githubUserId      BigInt?  @unique @map("github_user_id")
  role              Role     @default(STUDENT)
  /// Non-null marks this profile as a **test student** — a student-shaped identity an admin
  /// creates to look at a course the way a student meets it, accept its work, and grade the
  /// result. Its value is the number in the name: `Test Student 3`, handle `test-student-3`.
  ///
  /// One nullable ordinal rather than a boolean beside a counter, for two reasons. It carries
  /// both facts in one column, so "is a test student" and "which one" cannot disagree. And
  /// `@unique` is what makes two admins creating one at the same moment safe: the second loses
  /// the race at the database rather than by having checked first and been overtaken.
  ///
  /// Every reader that reports a *number of students* must exclude these
  /// (`where: { testStudentNumber: null }`) — a test row counted as a student is a figure
  /// somebody quotes. Readers that list students deliberately include them, badged, because
  /// grading one is the whole point.
  testStudentNumber Int?     @unique @map("test_student_number")
  /// The address of this person's own calendar feed, which a calendar application polls for their
  /// due dates. Written the first time they ask for the link and replaced whenever they ask again,
  /// so it is nullable: most profiles never ask, and an admin's never will.
  ///
  /// **The token is the whole of the authorization** on `GET /api/calendar/[token]`, because no
  /// calendar application sends a cookie. That is why the feed carries titles and dates and never a
  /// score or a status: a student may paste this address into a shared calendar, forward it, or
  /// lose it, and a leaked deadline is an inconvenience where a leaked grade is not.
  ///
  /// `@unique` because it is how the route finds this row, and because two profiles landing on one
  /// token must fail at the database rather than by having checked first and been overtaken.
  calendarToken     String?  @unique @map("calendar_token")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // @default(now()) is deliberate alongside @updatedAt: it puts a real DB
  // default on the column so the on-signup trigger (which writes via raw SQL,
  // bypassing Prisma) can insert without specifying updated_at.
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user AuthUser @relation(fields: [id], references: [id], onDelete: Cascade)

  programsInstructing  ProgramInstructor[]
  enrollments          Enrollment[]
  submissions          Submission[]
  gradedSubmissions    Submission[]            @relation("GradedBy")
  approvedDrafts       GradingDraft[]          @relation("ApprovedDrafts")
  editedSections       GradingDraftSection[]   @relation("EditedSections")
  invitesCreated       InstructorInvite[]      @relation("InvitesCreated")
  invitesRedeemed      InstructorInvite[]      @relation("InvitesRedeemed")
  rosterEntriesClaimed RosterEntry[]           @relation("RosterClaimed")
  rosterEntriesAdded   RosterEntry[]           @relation("RosterAdded")
  attendanceStarted    AttendanceSession[]     @relation("AttendanceStarted")
  attendanceRecorded   AttendanceRecord[]      @relation("AttendanceRecorded")
  gcfAttempts          GcfAttempt[]            @relation("GcfAttempts")
  gcfRecorded          GcfAttempt[]            @relation("GcfRecorded")
  gcfIdentities        GcfIdentity[]           @relation("GcfIdentities")
  handedIn             Submission[]            @relation("HandedInBy")
  commentsWritten      SubmissionComment[]     @relation("CommentsWritten")
  commentsResolved     Submission[]            @relation("CommentsResolved")
  commentReads         SubmissionCommentRead[] @relation("CommentReads")

  @@map("profiles")
  @@schema("public")
}

/// A link that makes whoever opens it an instructor.
///
/// **Single use and expiring**, which the course join link deliberately is not. That link admits
/// a stranger to one cohort; this one admits them to authoring and to every student's grades in
/// every course, so a forwarded one is a much sharper edge and reusing it has no upside — staff
/// arrive one at a time.
///
/// A row rather than a column on `Profile`, because the invitation exists before the person does.
/// That is the case that matters: a new hire has no reason to sign in to a system they cannot use
/// yet, and a flow requiring them to sign in first, do nothing, and wait to be found on a list is
/// a worse first day.
///
/// `redeemedById` and `redeemedAt` are what make "how did this person get access" answerable
/// afterwards, which is the question an audit actually asks.
model InstructorInvite {
  id    String @id @default(uuid()) @db.Uuid
  /// Opaque and unique. The URL is the whole of the credential, so it is generated the same way
  /// as a course join link — 32 hex characters from `crypto.randomUUID`.
  token String @unique

  createdById String   @map("created_by_id") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  /// Both null until somebody redeems it, and set together. Null `redeemedAt` is what "unused"
  /// means, so nothing else needs a status column.
  redeemedAt   DateTime? @map("redeemed_at") @db.Timestamptz(6)
  redeemedById String?   @map("redeemed_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Cascade: an admin's account being deleted should not leave invitations they issued behind.
  createdBy  Profile  @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  /// SetNull rather than Cascade. If the redeemer's account is deleted the *record that this
  /// invitation was used* must survive — deleting it would erase the audit trail by removing the
  /// person it was about.
  redeemedBy Profile? @relation("InvitesRedeemed", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("instructor_invites")
  @@schema("public")
}

// ===========================================================================
// Programs: what a fellow is admitted to, and what it owns
// ===========================================================================

/// One run of a program — "Software Engineering Fellowship", starting "Fall 2026".
///
/// **The thing a fellow is admitted to, and the thing a morning belongs to.** A program owns its
/// courses, one roster, one set of attendance days, its cohorts, and its instructors. A course goes
/// on owning its curriculum, its assignments, its gradebook, and its team sets, and owns neither
/// attendance nor enrollment.
///
/// **Attendance is what made the missing layer visible.** Before this, `Course` was the only
/// cohort-shaped thing in the schema, so a fellow taking three courses that all met on a Tuesday
/// had three sessions to check into and three codes to type. Once the layer above the course exists
/// the rest of the duplication is visible too: the same roster was entered once per course, the same
/// fellow joined by one link per course, and the division of that roster between co-teaching
/// instructors was rebuilt inside each course as its own set of groups.
///
/// **One row is one *run*.** "Software Engineering Fellowship" starting "Fall 2026" and the same
/// program starting "Fall 2027" are two rows, which is what `@@unique([name, term])` says.
/// A second table holding the name once would be a third level in every URL, every query, and every
/// guard for the sake of one string. A run is created empty; carrying a term forward is
/// `courses.create` copying a previous course, once per course.
model Program {
  id String @id @default(uuid()) @db.Uuid

  /// What the program is called, repeated by every run of it. See above for why that
  /// repetition is preferred to a table holding it once.
  name String

  /// When this run of the program begins, as a person says it — "Fall 2026".
  ///
  /// **Free text, and nothing parses it.** There are no term dates and no record of which weekdays
  /// the program meets, so a morning nobody opened stays indistinguishable from a morning the
  /// program did not meet, and no warning fires about a forgotten Tuesday. It is displayed, it is
  /// half of the identity, and it is an input to a course's suggested short name. See
  /// `AttendanceSession` for what the absence of a calendar costs and why the cost is accepted.
  term String

  /// The one link that enrolls a fellow in this program, and so in every published course of it.
  ///
  /// Moved up from the course, which is most of what this table is for: a fellow used to be sent one
  /// link per course and to arrive on one roster per course. **Necessary and not sufficient** —
  /// `RosterEntry` is the allowlist, so holding the link admits nobody who is not already expected
  /// by name. Random rather than derived from the id, because the id appears in URLs, and replacing
  /// it is the only control over who can still use it.
  joinToken String @unique @map("join_token")

  /// The link that makes whoever opens it an instructor of this program.
  ///
  /// The counterpart to `joinToken`, and the reason it is a second column rather than a reuse: the
  /// two grant opposite things. One admits somebody to the roster; this one admits them to
  /// authoring, to the gradebook, and to every fellow's grades in every course of the program.
  /// Reusable, like the join link and unlike an `InstructorInvite`, because a program gains
  /// co-teachers one at a time over a term.
  ///
  /// **Redeeming it never raises a role.** Only an account that already holds INSTRUCTOR or ADMIN
  /// can use it, and a student is refused rather than promoted. Becoming staff at all stays with
  /// `InstructorInvite` and an admin, so this grants a program and nothing more.
  instructorToken String @unique @map("instructor_token")

  /// Set when a run of the program finishes. It leaves every active list and stays readable to
  /// the people who were in it; nothing new can be submitted in it. Reversible, because a tidying
  /// action that cannot be undone gets avoided instead of used. A course carries its own, because
  /// courses inside one program finish at different times.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  /// How long after a day's check-in opens a fellow may still arrive and count as on time.
  ///
  /// The program's own norm rather than each course's, because there is one morning now rather than
  /// one per course. Copied onto each session when it starts rather than read at grading time — see
  /// `AttendanceSession.lateAfterMinutes` for why editing this must never rewrite a past morning.
  attendanceLateAfterMinutes Int @default(5) @map("attendance_late_after_minutes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses            Course[]
  instructors        ProgramInstructor[]
  cohorts            Cohort[]
  enrollments        Enrollment[]
  rosterEntries      RosterEntry[]
  attendanceSessions AttendanceSession[]

  /// One "Software Engineering Fellowship (Fall 2026)".
  @@unique([name, term])
  @@map("programs")
  @@schema("public")
}

/// One instructor of one program, and the row that grants everything an instructor can do.
///
/// **An instructor of a program may act in every course of it.** Authoring, grading, approving, and
/// reading every fellow's work are granted here rather than per course, which is what makes
/// `CourseInstructor` a statement about who teaches what rather than a permission. The reasoning is
/// the one that also left a cohort free of any instructor relation: a co-teacher covering for
/// somebody must be able to approve their drafts, and a rule that stops them is a rule people work
/// around rather than obey.
///
/// `isPrimary` marks the program's owner — whoever created it, or whoever it has since been handed
/// to. Everybody who teaches can author and grade; the owner can additionally archive the program,
/// delete it, decide who teaches which course, remove another instructor, and replace either link.
/// At most one row per program holds it, which a hand-written partial unique index says, because
/// Prisma cannot express a partial index.
model ProgramInstructor {
  id        String  @id @default(uuid()) @db.Uuid
  programId String  @map("program_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")

  /// Which cohort of this program's roster this instructor is currently working.
  ///
  /// A remembered filter and nothing more: it does not say who may grade, it grants and withholds
  /// nothing, and any instructor can change it at any moment from any screen showing the picker.
  /// **One value for the whole program**, which is the duplication this table removes — the fact it
  /// records is "I grade these fifteen fellows" and never "in this course I grade these fifteen".
  ///
  /// NULL is All Fellows, so the default is the behaviour that existed before cohorts. A plain
  /// foreign key with `onDelete: SetNull` rather than a composite one against `(id, programId)`:
  /// `SET NULL` on a two-column key nulls both columns, and `programId` is NOT NULL. `setCohort`
  /// checks the cohort belongs to the program instead, and storing a foreign one would only produce
  /// a permanently empty screen that reads as being caught up.
  cohortId String? @map("cohort_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort  Cohort?            @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  /// The courses this instructor is assigned to teach. Present so that removing somebody from the
  /// program takes those rows with them rather than leaving them behind.
  teaches CourseInstructor[]

  @@unique([programId, userId])
  @@index([cohortId])
  @@map("program_instructors")
  @@schema("public")
}

/// A named division of one program's roster — "Cohort A".
///
/// **What this code called a grading group.** A cohort is a set and nothing else: it has no
/// instructor, grants no permission, and decides nothing about who may grade. An instructor picks
/// one and the screens that answer "what is left" narrow to it. Splitting a roster between
/// co-teachers is what it is for, and that works because the piles stop overlapping rather than
/// because anything is enforced — a co-teacher covering for somebody must still be able to approve
/// their drafts.
///
/// **It belongs to the program rather than to a course**, which is the whole reason it moved. The
/// division of a roster between instructors was never a per-course fact, so rebuilding it inside
/// each course of a term was work that produced identical answers.
///
/// **A fellow is in at most one, and that is a column rather than a join table.**
/// `Enrollment.cohortId` says it, so the partition is true by construction rather than by a unique
/// constraint on a membership row, and "which cohort is this fellow in" has exactly one answer —
/// which is what "Instructor A grades Cohort A" needs it to have.
///
/// There is no "All Fellows" row. That is the picker's unfiltered option, so no membership exists
/// for it, no enrollment path has to remember to write one, and no instructor can rename or empty
/// it — which is what makes "every fellow is in the default view" true by construction.
model Cohort {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @map("program_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program    Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// The fellows in this cohort. Their side of the key is `Restrict`, so `cohorts.remove` clears
  /// them inside the transaction that deletes it rather than the database emptying or cascading.
  fellows    Enrollment[]
  /// The instructors currently filtered to this cohort. Present so that deleting one can null their
  /// column rather than orphan it.
  filteredBy ProgramInstructor[]

  /// One "Cohort A" per program. Ordered by name in the picker, which is why there is no position
  /// column: a list of four entries does not need reordering.
  @@unique([programId, name])
  /// Redundant against the primary key, and bought for one thing: `Enrollment` points at
  /// `(cohortId, programId)` together, which is what makes a fellow assigned to another program's
  /// cohort unrepresentable rather than merely refused by the procedure that writes it. A composite
  /// foreign key needs a unique index to reference.
  @@unique([id, programId])
  @@map("cohorts")
  @@schema("public")
}

// ===========================================================================
// Courses, enrollment, and assignments
//
// Ported from marcy-lms/db/schema.ts. Field names and semantics are unchanged;
// only the ORM and the user table it points at are different (Profile, not the
// old standalone users table).
// ===========================================================================

/// One course of a program: its curriculum, its assignments, its gradebook, and its team sets.
///
/// **A course no longer holds attendance or enrollment.** Both belong to the `Program` above it, so
/// there is one roster and one morning rather than one of each per course. What a course still owns
/// is everything about the work: `CourseUnit`, `Assignment`, `Submission` and everything beneath
/// them, and the `TeamSet` rows that divide the program's fellows for this course's projects.
model Course {
  id        String @id @default(uuid()) @db.Uuid
  programId String @map("program_id") @db.Uuid
  name      String

  /// The course's short name, which prefixes every repository it generates:
  /// `{slug}-{assignmentRepoName}-{github login}`.
  ///
  /// This is what makes two runs of one course distinct on GitHub —
  /// `swe-f26-swe-1-4-loops-benspector3` beside `swe-s27-swe-1-4-loops-benspector3`. Without it the
  /// name carries no term, so a fellow repeating a program would want the repository their previous
  /// run already holds, and copying a course to test it would collide with the original
  /// for anybody in both.
  ///
  /// **On the course rather than on the program**, deliberately. A program-level prefix would make
  /// an assignment's repository name have to be unique across the whole program, so two courses of
  /// one program could not both hold an assignment named `project-1`.
  /// `@@unique([courseId, assignmentRepoName])` on `Assignment` is what keeps that free.
  ///
  /// Suggested from the course name **and** the program's `term`, then editable — a course
  /// called "Fullstack Software Engineering" in a program starting "Fall 2026" offers `fse-f26`,
  /// which an instructor may edit to `swe-f26`. Both halves are in the suggestion because neither is
  /// unique on its own: every program a school runs starts in the fall, so a term-only slug would be
  /// the short name of whichever course was created first and a refusal for the rest.
  ///
  /// Frozen once anybody in the course has accepted anything: their repositories are already named
  /// after it, and renaming here would not rename theirs.
  ///
  /// Unique across every course of every program, archived ones included — their repositories still
  /// exist. The constraint is what guarantees it; naming both halves only makes collisions rare.
  slug String @unique

  /// Null until an instructor publishes the course, and what stops a fellow meeting a course that
  /// begins in March on the day they join the program.
  ///
  /// **The lever this replaces was not enrolling anybody yet.** Being on a program's roster now
  /// makes somebody a student of its courses, so that lever is gone, and `archivedAt` says
  /// "finished" rather than "not started". This is one nullable timestamp meaning exactly what
  /// `Assignment.distributedAt` means: instructors see the course and author in it, and fellows do
  /// not see it at all.
  ///
  /// **Three readers must agree about it, which is why one of them is a shared function.**
  /// `courses.listMine` filters a fellow's list on it, `assertCourseMember` refuses a fellow an
  /// unpublished course while admitting every instructor of its program, and `distributedToStudent`
  /// in lib/assignments/scope.ts carries the condition for both `assignments.listMine` and the
  /// calendar feed. Two of the three agreeing and the third not is how somebody gets a deadline in
  /// their calendar for a course they cannot open; `verify:calendar` is the check that catches it.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  /// Set when this course finishes, which is not when its program does — a program runs nine months
  /// and its courses end at different points inside that. The course leaves every active list and
  /// stays readable to the people who were in it; nothing new can be submitted. Reversible, because
  /// a tidying action that cannot be undone gets avoided instead of used.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program     Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  instructors CourseInstructor[]
  assignments Assignment[]
  courseUnits CourseUnit[]
  teamSets    TeamSet[]

  /// Redundant against the primary key, and bought for two readers: `CourseInstructor` and
  /// `TeamSet` both point at `(courseId, programId)` together, which is what makes a course of one
  /// program being taught by another program's instructor, or holding another program's team set,
  /// unrepresentable rather than merely refused.
  @@unique([id, programId])
  @@index([programId])
  @@map("courses")
  @@schema("public")
}

/// Who teaches one course, which is a statement about work rather than a permission.
///
/// **This row grants nothing.** Authority comes from `ProgramInstructor`: an instructor of a program
/// may author, grade, and approve in every course of it. What this decides is whose name is on the
/// course, who is added as a collaborator on every repository it generates — so no repository ever
/// needs a manual permission change — and which course an instructor's screens open on.
///
/// **Two composite foreign keys hold one fact, and they share `programId`.** `(courseId, programId)`
/// says the course belongs to the program, and `(programId, userId)` says the person is an instructor
/// of it. There is no value `programId` could hold that satisfies both while naming somebody who is
/// not an instructor of that course's program, so the mistake is unrepresentable rather than refused
/// by whichever procedure happened to be asked.
///
/// The second key also removes a cleanup step: it cascades, so taking somebody off a program takes
/// every course they were teaching in it with them.
///
/// There is deliberately no `isPrimary` here. Ownership is a program fact — see
/// `ProgramInstructor.isPrimary` — because the actions it gates (archiving, deleting, deciding who
/// teaches what) are about the program rather than about one of its courses.
model CourseInstructor {
  id        String   @id @default(uuid()) @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  programId String   @map("program_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course            Course            @relation(fields: [courseId, programId], references: [id, programId], onDelete: Cascade)
  programInstructor ProgramInstructor @relation(fields: [programId, userId], references: [programId, userId], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([programId, userId])
  @@map("course_instructors")
  @@schema("public")
}

enum EnrollmentStatus {
  ACTIVE
  /// The student is no longer in the cohort. They keep reading the feedback they were
  /// given and the course stays in their list, labelled; they cannot accept, submit, or
  /// upload, and they are not counted as a student anywhere.
  ///
  /// Removal is a status rather than a deleted row because a student who leaves had
  /// submissions, grades, and released feedback, and destroying those to tidy a roster is
  /// the worse failure.
  REMOVED

  @@schema("public")
}

/// One fellow in one program, and so in every published course of it.
///
/// **There is no per-course enrollment**, and removing it is the point of the program. Being on a
/// program's roster is being a student of its courses, so there is one roster, one join link, one
/// cohort, and one attendance day per fellow rather than one of each per course. A course a fellow
/// should not yet see is a course that has not been published — see `Course.publishedAt` — rather
/// than a fellow who has not been enrolled.
///
/// **A fellow who repeats, repeats the program.** They enroll in the next run of it and take
/// every course in it. There is no way to join a single course, and that is deliberate rather than
/// an oversight: it is what gives the roster, the cohort, and the morning exactly one answer each.
///
/// The row is created *by* a fellow redeeming the program's join link, so it never exists without
/// one — which is why `studentId` is NOT NULL and why there is no "invited" state.
/// `@@unique([programId, studentId])` is what makes redeeming a link twice return the enrollment
/// that exists rather than adding a second.
model Enrollment {
  id        String @id @default(uuid()) @db.Uuid
  programId String @map("program_id") @db.Uuid
  studentId String @map("student_id") @db.Uuid

  /// Which cohort of this program's roster the fellow is in. NULL is unassigned, and it is what the
  /// picker's "No cohort" entry selects.
  ///
  /// **A column rather than a membership table, because a cohort is a partition.** A fellow is in at
  /// most one, so this says it by construction; a join table would need a unique constraint to say
  /// the same thing and would still allow the question two answers between two writes.
  ///
  /// **The composite key is what holds this to a cohort of the fellow's own program.** Before
  /// cohorts moved up, the equivalent was a plain key plus a check inside `setMembers`, whose own
  /// comment said the key alone would accept another course's enrollment. The pair makes the mistake
  /// unrepresentable and deletes the check. It is `MATCH SIMPLE`, so a NULL `cohortId` satisfies it
  /// whatever `programId` holds, which is exactly what unassigned needs.
  ///
  /// `onDelete: Restrict` rather than `SetNull`, and not by preference: `SET NULL` on a two-column
  /// key nulls both columns, and `programId` is NOT NULL. So `cohorts.remove` clears its fellows
  /// inside the transaction that deletes the cohort, and the database refuses if that is ever
  /// missed.
  cohortId String? @map("cohort_id") @db.Uuid

  status    EnrollmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program         Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  student         Profile            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohort          Cohort?            @relation(fields: [cohortId, programId], references: [id, programId], onDelete: Restrict)
  teamMemberships TeamMembership[]
  attendance      AttendanceRecord[]

  @@unique([programId, studentId])
  /// Redundant on its own — `id` is already the primary key — and bought for two readers:
  /// `AttendanceRecord` and `TeamMembership` both point at `(enrollmentId, programId)` together,
  /// which is what makes a row written against another program's fellow unrepresentable rather than
  /// merely refused by the procedure that writes it.
  @@unique([id, programId])
  @@index([cohortId])
  @@map("enrollments")
  @@schema("public")
}

// ===========================================================================
// Teams, and work handed in by one
// ===========================================================================

/// A named, reusable collection of the teams one course's fellows work in — "Unit 3 project teams".
///
/// **A second mechanism beside `Cohort`, deliberately not an extension of it.** A cohort divides a
/// program's roster between co-teachers: it is a filter, fellows never see it, and it decides
/// nothing about the work. A team hands in one piece of work and receives one grade, and its members
/// can see each other. Keeping them apart is what stops a finished project's teams from crowding the
/// grading-split picker.
///
/// **A set belongs to one course**, because a project belongs to one course, while the fellows on
/// its teams belong to the program. A set rather than a flat list of teams, because a course runs
/// several projects and each wants its own division of the same fellows. An assignment names a set,
/// not the teams in it, so pointing the second and third assignments of one project at the same
/// teams is one choice rather than a list re-picked each time.
model TeamSet {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @map("course_id") @db.Uuid

  /// The program this set's course belongs to, carried rather than read through the course.
  ///
  /// **It exists so `TeamMembership` can hold a set and an enrollment to the same program at once.**
  /// A set is scoped to a course and an enrollment to a program, so without this column the two ends
  /// of a membership share no column and the chain of keys proves nothing. The composite key below
  /// is what keeps it equal to the course's own program, so the fact is asserted once here rather
  /// than once per fellow per project.
  programId String @map("program_id") @db.Uuid

  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course           @relation(fields: [courseId, programId], references: [id, programId], onDelete: Cascade)
  teams       Team[]
  memberships TeamMembership[]
  assignments Assignment[]

  /// One "Unit 3 project teams" per course.
  @@unique([courseId, name])
  /// For `Team` and `Assignment`, both of which point at `(id, courseId)` so a team or an assignment
  /// of another course cannot name this set.
  @@unique([id, courseId])
  /// For `TeamMembership`, which points at `(id, programId)` so a membership joining another
  /// program's fellow is unrepresentable rather than merely unlikely.
  @@unique([id, programId])
  @@index([programId])
  @@map("team_sets")
  @@schema("public")
}

/// One team inside a set: the students who hand in together and receive one grade.
///
/// `position` exists though `Cohort` deliberately has none, because a set is created by asking how
/// many teams it holds. The rows are born in order and stay in it, so "Team 4" does not sort after
/// "Team 12" the way a list ordered by name would.
///
/// `courseId` is carried rather than read through the set, so the key below can hold a team to a set
/// of the same course. A membership reaches the program through the set's own `programId` instead —
/// see `TeamMembership`, which carries no course at all.
model Team {
  id        String   @id @default(uuid()) @db.Uuid
  teamSetId String   @map("team_set_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  teamSet     TeamSet          @relation(fields: [teamSetId, courseId], references: [id, courseId], onDelete: Cascade)
  memberships TeamMembership[]
  submissions Submission[]

  /// One "Team 3" per set, and one team in each position.
  @@unique([teamSetId, name])
  @@unique([teamSetId, position])
  /// For the composite foreign keys on `TeamMembership` and `Submission`, both of which point
  /// at a team *and* the set it belongs to, so a team from another set cannot be named.
  @@unique([id, teamSetId])
  @@index([courseId])
  @@map("teams")
  @@schema("public")
}

/// One fellow's place on one team.
///
/// Joined to the **enrollment** rather than to the profile, so a foreign key guarantees a team's
/// members are fellows of the program whose course owns that team's set — where a validation rule is
/// something a second caller can forget.
///
/// **Three foreign keys hold one fact, and they share `programId`.** `(teamId, teamSetId)` says the
/// team belongs to the set, `(teamSetId, programId)` says the set belongs to a course of this
/// program, and `(enrollmentId, programId)` says the fellow is enrolled in it. There is no value
/// `programId` could hold that satisfies all three while naming another program's fellow, so the
/// mistake is unrepresentable rather than refused. The course is reached through the set, which
/// carries `programId` for exactly this reason.
///
/// **`@@unique([teamSetId, enrollmentId])` is what makes a set a partition.** A fellow is on at most
/// one team of any one set, which is what "which team are you on for this project" needs to have a
/// single answer. They may be on a team in every other set, which is what makes a set reusable
/// across projects.
///
/// A removed fellow keeps their memberships, as they keep their cohort: removal is a status rather
/// than a deleted row, so restoring somebody returns them to the team they were on.
model TeamMembership {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  teamSetId    String   @map("team_set_id") @db.Uuid
  programId    String   @map("program_id") @db.Uuid
  enrollmentId String   @map("enrollment_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  team       Team       @relation(fields: [teamId, teamSetId], references: [id, teamSetId], onDelete: Cascade)
  teamSet    TeamSet    @relation(fields: [teamSetId, programId], references: [id, programId], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId, programId], references: [id, programId], onDelete: Cascade)

  @@unique([teamSetId, enrollmentId])
  @@index([enrollmentId])
  @@index([teamId])
  @@map("team_memberships")
  @@schema("public")
}

enum RubricScaleType {
  POINTS
  CHECKLIST
  SHORT_RESPONSE

  @@schema("public")
}

/// Seeded with exactly the four sections that already exist in rubric.md:
/// SHORT_RESPONSE, CODING_ALGORITHM_FLUENCY, CODING_SQL_FLUENCY,
/// CODING_FRONTEND. This is a fixed taxonomy today, not an instructor-authored
/// rubric builder.
model Rubric {
  id        String          @id @default(uuid()) @db.Uuid
  name      String          @unique
  scaleType RubricScaleType @map("scale_type")
  /// Array of {key, label, max_points, description}.
  criteria  Json            @default("[]")
  maxScore  Int             @map("max_score")
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("rubrics")
  @@schema("public")
}

/// What a student turns in. This decides how an assignment is distributed, what a
/// submission consists of, and how feedback is delivered — see the README.
///
/// **Four kinds, distinguished by distribution rather than by collection.** How the work is
/// handed in is `Assignment.handInMethods` for the one kind that leaves it open, and a
/// property of the kind for the three that do not — `handInMethodsFor` in
/// lib/assignments/spec.ts is where those four answers are given, in one exhaustive switch.
enum AssignmentKind {
  /// Generated from a template repository; submitted as a pull request.
  REPO
  /// A Google Drive document — a Doc, a Sheet, or a Slides deck — that the student takes
  /// their own copy of; submitted as a link to their copy.
  ///
  /// One kind rather than three because nothing about the three differs here: all of them
  /// are handed out as a `/copy` link built the same way, handed in as a link, and graded by
  /// hand. What distinguishes an assignment is the template it names, and the editor is a
  /// property of that link rather than of the assignment.
  GOOGLE_DRIVE
  /// Work the student made wherever they liked — a Canva design, a Loom recording, a deck, a
  /// document, a deployed site — handed in as a link to it, as an uploaded file, or as
  /// either, whichever the instructor allowed in `handInMethods`.
  ///
  /// **Nothing is handed out, which is what separates this from GOOGLE_DRIVE.** A Drive
  /// assignment distributes a template to copy and can therefore check the submitted link's
  /// shape against it; this one distributes nothing, so there is no Accept and no pattern a
  /// valid link could be checked against.
  ///
  /// One kind rather than one per collection method, by the same rule that made three Google
  /// editors one kind: a link and a file differ in how the work arrives and in nothing else.
  /// Both are made by the student somewhere this application cannot see, and both are graded
  /// by hand. So the way in is a property of the assignment, and an assignment may name more
  /// than one — which is what lets a reflection be a document, a deck, or a short recording,
  /// at the student's choice.
  SELF_DIRECTED
  /// Work with nothing to hand in at all: setting up a laptop, joining a Slack workspace,
  /// filling in a survey. The student marks it done themselves, and an instructor may set
  /// either verdict over the top of that.
  ///
  /// **Nothing is handed out and nothing is collected**, which is what separates this from
  /// SELF_DIRECTED — that kind distributes nothing either, but still requires an artifact to
  /// come back, so it always draws a form. This draws a button. `handInMethodsFor` returns an
  /// empty list, the same answer REPO gets, and for the same shape of reason: the way in is
  /// not one of `HandInMethod`. The difference is that REPO has a way in and this has none.
  ///
  /// **Worth exactly one point, and `sections` is empty.** There is nothing to write a report
  /// against, so a task carries no gradable section and `assignmentPointValue` in
  /// lib/assignments/spec.ts answers 1 for this kind without consulting the column. That is
  /// what keeps a task out of every grading surface: `isManualOnly` is false on an empty
  /// section list, so a task never becomes `needs_manual_grade`, and no draft is ever opened
  /// for one.
  ///
  /// **A submission's status goes NOT_STARTED to GRADED and never through SUBMITTED**, because
  /// a marked task waits on nobody. `triageBucket` returns null for both, so a task never
  /// enters triage, the grading queue's review count, or a batch report run.
  TASK

  @@schema("public")
}

/// How work reaches an instructor, for an assignment whose kind does not decide it.
///
/// Deliberately not "the kind of thing submitted": a PDF and a Word document are one method,
/// and a Loom recording and a Figma file are the other. What separates them is the machinery
/// — bytes into a private bucket, against a URL in a column — and that is what every rule
/// downstream branches on, from `assertCanHandIn` to which form the student is shown.
enum HandInMethod {
  /// A URL the student pastes, to work that lives somewhere this application does not control.
  LINK
  /// Bytes the student uploads into the private bucket, of a type the assignment accepts.
  FILE

  @@schema("public")
}

/// What a course unit is *for*, which is the only thing that distinguishes the three.
///
/// A module, a project, and an assessment are the same shape — a named, ordered container of
/// assignments and resources — so they are one table with a category rather than two tables and
/// a foreign key between them. That earlier design gave an assignment two possible parents and
/// needed a rule deriving one from the other; this has one parent and no rule.
enum CourseUnitCategory {
  /// Skill development: the ordinary teaching unit.
  MODULE
  /// Skill application: several assignments that add up to one piece of work, which the
  /// curriculum calls deliverables.
  PROJECT
  /// Skill evaluation: several assignments, each submitted separately and often in a different
  /// format — a coding repository, a short response, a link to a diagram.
  ASSESSMENT

  @@schema("public")
}

/// One unit of a course — a module, a project, or an assessment — created and named by an
/// instructor.
///
/// Deliberately not tied to anything outside the application. A module used to be a
/// *tag* — one string that was simultaneously the grouping key, the authoring form's
/// choices, a validation constraint, and the first path segment of every answer-key
/// path in the grading-guides repository. That last job is why a course's module list
/// could not be corrected: correcting it moved where grading looked for answer keys.
/// A repository the assignment itself names is now what says where its answer keys
/// are, so a unit is free to be whatever an instructor calls it.
///
/// **The id is the identity, not the name.** With the name as the identity a rename
/// rewrites every assignment that used it and is still only ever a string; with a row,
/// renaming is one column and `assignments.course_unit_id` goes on pointing at the same
/// unit. The foreign key is also what enforces "a unit must exist before an assignment can be
/// added to it", rather than validation code a second caller could forget to run.
///
/// **No score, no due date, and no completion column.** All three are derived: a unit's due
/// date is the latest among its assignments, and a student has completed it when every one of
/// its published assignments has `isComplete` — the column `approveDraft` writes once. A stored
/// verdict here would be a second answer to a question the assignments have already answered.
model CourseUnit {
  id       String             @id @default(uuid()) @db.Uuid
  courseId String             @map("course_id") @db.Uuid
  /// What this unit is for. Defaults to MODULE, which is what every row was before the three
  /// were one table.
  category CourseUnitCategory @default(MODULE)
  /// Free text, typed by an instructor. Nothing is derived from it and nothing parses
  /// it: "Mod 4 - Interactive & Data-Driven User Interfaces" is the title, not a tag a
  /// display name is computed from.
  name     String
  /// Presentation order within the course, **shared by all three categories**, so a project
  /// sits between Mod 3 and Mod 4 where it falls in the term and a student's course page is one
  /// ordered list.
  ///
  /// Deliberately NOT unique — `reorder` rewrites the whole sequence in one statement, and a
  /// unique constraint would refuse any intermediate state where two units briefly share a
  /// position. Duplicates would only affect tie-breaking, which rewriting the sequence prevents
  /// anyway.
  position Int
  /// What the unit is, in markdown, written by an instructor. A project's brief lives here.
  ///
  /// On every category rather than only the two that are obviously briefed: a module with an
  /// introduction is a real thing, and restricting the column would be a rule with no reason
  /// behind it. Rendered through components/markdown.tsx — the same renderer feedback uses.
  overview String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  assignments Assignment[]
  resources   Resource[]

  /// One "Mod 4" per course, **across every category**. A module and a project sharing a name
  /// would be indistinguishable in every select an instructor picks from, so they get called
  /// "Mod 4" and "Mod 4 Project".
  @@unique([courseId, name])
  @@index([courseId, position])
  @@map("course_units")
  @@schema("public")
}

/// What a resource *is*, which decides which of the columns below mean anything.
///
/// Named in full before any of it was built, the way `AssignmentKind` was: a code path that
/// has to say which kinds it handles cannot silently work for one and break on the next, and
/// the compiler enumerates the places that must decide rather than a search hoping to.
enum ResourceKind {
  /// A title, a URL, and an optional line saying what it is. The whole of the readings case,
  /// and the only kind that needs no editor at all.
  LINK
  /// Markdown an instructor writes. Markdown rather than a second format because
  /// `submissionInstructions` already is, and a student's feedback already renders through
  /// this application's own renderer — a second content format is a second renderer and a
  /// second set of rules about what may appear in it.
  TEXT
  /// A video from a provider this application recognises, embedded in the page.
  VIDEO

  @@schema("public")
}

/// The video services whose embeds this application will build.
///
/// A closed vocabulary, for the same reason the upload check is one. The alternative is
/// accepting embed HTML an instructor pastes, which is an arbitrary iframe — or worse — on a
/// page every student in the cohort opens.
enum VideoProvider {
  YOUTUBE
  VIMEO

  @@schema("public")
}

/// Something in a module that is not work: a reading, a note, a video.
///
/// **Nothing here is graded, submitted, or in the gradebook**, and saying that plainly is most
/// of the design. The value is that a student's course page becomes the whole of the course
/// rather than only the parts that are marked.
///
/// A sibling of `Assignment` under `CourseUnit` rather than a shared parent both hang off. The
/// tidier model is one "unit item" that is either of them, and it is a much larger migration:
/// `Assignment` is referenced by submissions, grading drafts, and test runs. This costs every
/// reader that wants "everything in this unit" a merge of two lists, which is a cost paid in
/// three screens rather than across the whole schema.
///
/// **No `courseId`.** `Assignment` carries one because a repository name is unique per course
/// and the constraint needs the column; nothing here is unique per course, and every query has
/// a module to reach through. One less denormalized column is one less thing that can come to
/// disagree with the module it hangs off.
///
/// **No `distributedAt` and no draft state**, deliberately. An assignment has one because
/// handing it out starts a clock and creates work; a link to a reading does neither, and a
/// student seeing one early is not the problem an unfinished assignment is. Adding the column
/// later is cheap; taking a publish step away once instructors rely on it is not.
///
/// **Ordered by hand, within its module.** A module's readings are a sequence an instructor
/// chose — a lecture recording above the reading that follows it — and the alphabet cannot know
/// that order. Assignments beneath them still sort by due date, and the two lists are drawn
/// separately, so there is never a deadline to compare against a title.
model Resource {
  id           String       @id @default(uuid()) @db.Uuid
  courseUnitId String       @map("course_unit_id") @db.Uuid
  kind         ResourceKind
  /// What it is called, for every kind.
  title        String

  /// Presentation order within its module, dense from zero, assigned by the server and never
  /// sent by the browser. A new resource is added at the end and dragged from there.
  ///
  /// Deliberately NOT unique, for the same reason `CourseUnit.position` is not: `reorder`
  /// rewrites a whole sequence in one statement, and a unique constraint would refuse any
  /// intermediate state where two resources briefly share a position. Ties only affect
  /// tie-breaking, which every ordering here settles with the title.
  position     Int

  /// Where it points, for LINK and VIDEO. Validated as a URL by the schema rather than by the
  /// column, because "required for one kind" is not something a column can express.
  url String?

  /// One line saying what a LINK is and why it is here. Plain text, not markdown: it renders
  /// inside a row beside the title, and a row is not a place for a heading or a list.
  description String?

  /// The markdown of a TEXT resource. Rendered through the same renderer as a student's
  /// feedback, so what is allowed in it is already decided.
  body String?

  /// A VIDEO's provider and its id *on* that provider, derived from the URL an instructor
  /// pasted and stored rather than parsed at render time. The embed is built from these two
  /// and never from a string somebody typed, which is what makes the vocabulary closed: a URL
  /// this application does not recognise is refused when it is saved, not rendered as an
  /// iframe pointing somewhere nobody checked.
  videoProvider VideoProvider? @map("video_provider")
  videoId       String?        @map("video_id")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  courseUnit CourseUnit @relation(fields: [courseUnitId], references: [id], onDelete: Cascade)

  /// Cascade rather than restrict, which is the opposite of what an assignment gets from its
  /// unit — and right for the opposite reason. `courseUnits.remove` refuses while assignments
  /// reference the unit, because those carry submissions and grades that would be destroyed
  /// with it. A resource carries nothing: it is a title and a link, and re-adding one costs a
  /// minute. Refusing to remove an empty unit because somebody left a reading in it would be
  /// a guard against nothing.
  @@index([courseUnitId, position])
  @@map("resources")
  @@schema("public")
}

model Assignment {
  id                  String         @id @default(uuid()) @db.Uuid
  courseId            String         @map("course_id") @db.Uuid
  title               String
  /// Which unit of the course this belongs to — a module, a project, or an assessment. NOT
  /// NULL, so an assignment cannot exist outside one.
  ///
  /// **One parent, and the unit's own `category` is what says which of the three kinds of work
  /// this is.** There is deliberately no category column here to agree or disagree with it, and
  /// no second parent to derive this one from.
  courseUnitId        String         @map("course_unit_id") @db.Uuid
  kind                AssignmentKind @default(REPO)
  /// How this is handed in, for the one kind that leaves it open.
  ///
  /// **Empty for REPO and GOOGLE_DRIVE, and read for neither.** Their kind already answers the
  /// question — a pull request, a link to the student's copy — so recording it again here would
  /// be a second place for a fact that has one source, free to disagree with it. That is the
  /// same rule `courseUnitId` above states about the unit's category. `handInMethodsFor` in
  /// lib/assignments/spec.ts gives all three answers in one exhaustive switch, and it is the
  /// only thing that should read this column.
  ///
  /// Non-empty for SELF_DIRECTED, where the instructor chooses: a link, a file, or either. Both
  /// is the case this exists for — a reflection handed in as a document by one student, a deck
  /// by another, and a short recording by a third.
  handInMethods       HandInMethod[] @default([]) @map("hand_in_methods")
  pointValue          Int            @map("point_value")
  /// Matches the real "Complete/Incomplete at 75%" policy in
  /// working-with-assignments.md.
  completionThreshold Float          @default(0.75) @map("completion_threshold")
  dueAt               DateTime?      @map("due_at") @db.Timestamptz(6)
  /// The repository columns below are required when `kind` is REPO and null
  /// otherwise. The requirement is enforced by the Zod schema in lib/assignments/spec.ts rather
  /// than by the columns, because a column cannot express "required for one kind"
  /// — and a NOT NULL here would force a Google Doc assignment to invent a
  /// repository name.
  ///
  /// `@@unique([courseId, assignmentRepoName])` below needs no change to
  /// accommodate that: Postgres treats NULLs as distinct in a unique constraint,
  /// so it goes on constraining repository-backed assignments and ignores the
  /// rest.

  /// "owner/repo" of the template this assignment is generated from.
  ///
  /// Entered as a pasted URL and stored normalized — see lib/assignments/repo-ref.ts.
  /// It has to be a public repository with GitHub's template flag set: an installation
  /// token can read a public repository in an organization the App is not installed on,
  /// and `generate` refuses a repository that is not a template.
  templateRepo       String? @map("template_repo")
  /// "owner/repo" of the repository holding this assignment's reference solutions.
  ///
  /// **Private, in an organization the App is installed on.** Templates are public
  /// because every student's repository is generated from one; reference solutions are
  /// not, and nothing about this design publishes them.
  ///
  /// Per assignment rather than one repository for the whole program, which is what
  /// GRADING_ASSETS_REPO used to be for. That variable keeps a narrower job: `rubric.md`,
  /// `agent-rules.md`, and the sample reports are program-wide prompt code and are still
  /// read from it.
  answerKeyRepo      String? @map("answer_key_repo")
  /// The directory inside `answerKeyRepo` whose contents *are* the reference solutions.
  ///
  /// Every file under it, at any depth, with nothing selected. An instructor pastes the
  /// address of the folder they already have open and there is no second question — and a
  /// reference solution added to the folder later is used on the next run rather than being
  /// missed because nobody remembered to tick it.
  ///
  /// `""` is the repository root, which is the right answer for a repository holding a single
  /// assignment's solutions and nothing else. NULL for the kinds with no repository, which
  /// have no reference solutions at all. Recognisable binaries are skipped and the file count
  /// is capped, both reported rather than silent — see lib/grade/assets.ts.
  answerKeyDir       String? @map("answer_key_dir")
  /// The repository name prefix, e.g. "swe-1-4-loops". Generated repositories are named
  /// `{slug}-{assignmentRepoName}-{student github login}`, where the slug comes from the course —
  /// see `Course.slug`. **The uniqueness below is per course rather than per program**, which is
  /// what lets two courses of one program both hold an assignment named `project-1`.
  assignmentRepoName String? @map("assignment_repo_name")
  githubOrg          String? @map("github_org")
  /// Which template commit the tests come from. Null means the template's
  /// default branch, which is what you want during a cohort: a bug fixed in the
  /// template reaches every subsequent run, including re-runs for students who
  /// accepted before the fix. Set it to an exact commit SHA to archive a
  /// finished cohort, so re-grading an old submission years later reproduces
  /// the result it originally received.
  templateRef        String? @map("template_ref")

  /// The Drive file a GOOGLE_DRIVE assignment is copied from — a Doc, a Sheet, or a
  /// Slides deck. Required when `kind` is GOOGLE_DRIVE and null otherwise, enforced by
  /// the Zod schema for the same reason the three GitHub columns above are.
  ///
  /// A student pressing Accept is sent to this URL with its last path segment
  /// swapped for `/copy`, which is Google's own prompt to take a copy. So the
  /// application creates nothing, stores no Google credentials, and the copy
  /// belongs to the student from the moment it exists. It works because that is
  /// how Google's editor URLs are shaped — `/document/d/<id>/`, `/spreadsheets/d/<id>/`,
  /// `/presentation/d/<id>/` — and it breaks if that changes.
  templateDriveUrl String? @map("template_drive_url")

  /// Whether a fellow may set this task's verdict themselves, or only their instructor may.
  ///
  /// **Required when `kind` is TASK and null otherwise**, enforced by the Zod schema for the same
  /// reason `templateDriveUrl` above is: a column cannot express "required for one kind", and a
  /// NOT NULL here would make every repository assignment answer a question about marking that
  /// does not apply to it.
  ///
  /// A boolean rather than an enum naming the two parties, because there are two answers and
  /// there is no third to leave room for. "The fellow marks it and the instructor confirms" is
  /// not a third answer — it is what `true` already describes, since an instructor may set either
  /// verdict over the top of a fellow's mark whatever this says.
  ///
  /// **`true` is the permissive answer and the default.** A task nobody said otherwise about is
  /// one a fellow marks done, which is what every task did before this column existed. `false`
  /// says the fellow does the thing and somebody else attests to it — a laptop an instructor
  /// checks over, a form only they can see the responses to.
  ///
  /// Read through `taskIsSelfMarked` in lib/assignments/spec.ts and nowhere else, because the
  /// student's screen and the mutation that refuses them have to agree: a button drawn where the
  /// server will refuse it is a fellow pressing it and being told no.
  studentMayMarkDone Boolean? @map("student_may_mark_done")

  /// Which kinds of file this assignment accepts, as keys of UPLOAD_FILE_TYPES in
  /// lib/uploads/file-types.ts. Non-empty when FILE is one of `handInMethods` and
  /// empty otherwise, enforced by the Zod schema for the same reason the columns
  /// above are.
  ///
  /// Keyed on the method rather than on the kind, because the kind no longer decides
  /// it: a SELF_DIRECTED assignment accepting only a link wants none of these, and the
  /// same kind accepting a file wants at least one.
  ///
  /// On the assignment rather than global because "one PDF" and "a screenshot of
  /// your finished page" are different assignments. The size limit is global and
  /// lives in code, because no assignment has a reason to want a different one.
  ///
  /// Keys rather than extensions or MIME types: an instructor ticks named types
  /// and the extensions follow, so there is no way to store a set of extensions
  /// that no browser produces.
  acceptedFileTypes String[] @default([]) @map("accepted_file_types")

  /// How a student turns this in, in markdown, written by the instructor.
  ///
  /// Optional on every kind. A REPO assignment's ritual is fixed and the student's
  /// screen states it without being told; the other two kinds have no ritual, so
  /// this is where "paste the link to your copy" or "one PDF, named after you"
  /// gets said. Rendered through components/markdown.tsx — the same renderer
  /// feedback already uses, rather than a WYSIWYG dependency for text this
  /// application can already render.
  submissionInstructions String? @map("submission_instructions")

  /// The set of teams this assignment is handed in by, or null for work each student does
  /// alone. **Pointing at a set is what makes an assignment team work**; there is no boolean
  /// beside it to disagree, for the same reason there is no `category` column beside the unit's.
  ///
  /// `Restrict`, so a set cannot be deleted out from under work that was graded through it. The
  /// composite reference is to `(id, courseId)` rather than to the id alone, which is what makes
  /// naming another cohort's team set unrepresentable.
  teamSetId String? @map("team_set_id") @db.Uuid

  distributedAt DateTime? @map("distributed_at") @db.Timestamptz(6)
  /// One entry per gradable section this assignment can contain, e.g.
  /// [{ "type": "coding_algorithm", "rubricId": "...",
  ///    "reportTemplate": "coding-fluency" }]
  ///
  /// A section does not name reference solutions. Those come from `answerKeyDir` and are the
  /// same for every section of the assignment, which for a multi-section assignment means each
  /// section is given the whole folder.
  ///
  /// Explicit rather than convention-based because real assignments do not use
  /// consistent {from-scratch,debug,modify}.js filenames, and one pull request
  /// can contain several gradable sections at once.
  ///
  /// Two optional fields per entry control test evidence:
  ///   "evidence": "tests"        — absent means no deterministic evidence
  ///   "testNamePattern": "^from-scratch"
  ///                              — absent with evidence:"tests" means the
  ///                                whole suite counts toward this section
  sections      Json      @default("[]")

  /// Names an entry in lib/sandbox/presets.ts. "none" is a real preset and the
  /// default: short response assignments have nothing to execute, and frontend
  /// assignments have tests this build cannot run yet. The default is "none"
  /// rather than "node-jest" so that an unconfigured assignment produces no
  /// evidence instead of quietly producing the wrong evidence.
  runnerPreset String @default("none") @map("runner_preset")
  /// Shallow override merged over the named preset. Most assignments leave this
  /// null. An assignment needing a system dependency gets a purpose-built E2B
  /// template and names it here as `{"e2bTemplate": "..."}`, with no code change.
  runnerConfig Json?  @map("runner_config")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  course               Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Restrict rather than Cascade: removing a unit must never silently delete the
  /// assignments in it, along with their submissions and every graded draft beneath
  /// them. `courseUnits.remove` refuses while any assignment references it, and this is
  /// the database saying the same thing rather than trusting that it was asked.
  courseUnit           CourseUnit   @relation(fields: [courseUnitId], references: [id], onDelete: Restrict)
  teamSet              TeamSet?     @relation(fields: [teamSetId, courseId], references: [id, courseId], onDelete: Restrict)
  submissions          Submission[]
  /// Never read. It exists so that the foreign key behind it exists — see
  /// `Submission.assignmentTeamSet`. `submissions` above is the relation to use.
  submissionsByTeamSet Submission[] @relation("SubmissionTeamSet")

  @@unique([courseId, assignmentRepoName])
  /// Redundant against the primary key, and bought so a submission can point at
  /// `(assignmentId, teamSetId)` together — which is what stops a submission naming a team from
  /// some set other than the one its own assignment is handed in by.
  @@unique([id, teamSetId])
  @@index([courseUnitId])
  @@index([teamSetId])
  @@map("assignments")
  @@schema("public")
}

// ===========================================================================
// Submissions and grading
// ===========================================================================

enum SubmissionStatus {
  NOT_STARTED
  ACCEPTED
  SUBMITTED
  DRAFT_READY
  GRADED
  /// Work revised after a grade was issued, and declared ready for another look.
  /// Distinct from SUBMITTED because an instructor working through a queue needs to
  /// tell a first submission from a revision.
  RESUBMITTED
  GRADING_FAILED
  NEEDS_MANUAL_REVIEW

  @@schema("public")
}

enum SalesforceSyncStatus {
  PENDING
  SYNCED
  FAILED

  @@schema("public")
}

/// One row per (assignment, student), whether the work was done alone or by a team.
model Submission {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @map("assignment_id") @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  status       SubmissionStatus @default(NOT_STARTED)

  /// The team this was handed in by, and the set that team belongs to. Both null for work a
  /// student does alone.
  ///
  /// `teamSetId` is carried rather than read through the team so that two composite foreign keys
  /// can hold one fact from both ends: the team belongs to the set, and the set is the one this
  /// row's own assignment is handed in by. A submission naming another project's team is then
  /// unrepresentable rather than merely unlikely.
  teamId    String? @map("team_id") @db.Uuid
  teamSetId String? @map("team_set_id") @db.Uuid

  /// The team's own row, when this one is a **mirror** of it: one member's copy of the grade
  /// their team was given.
  ///
  /// Null on every submission a student holds in their own right, and on the one row per team
  /// that holds the work — the repository, the pull request, the uploaded file, and every
  /// grading draft and test run. A mirror carries status and outcome and nothing about where the
  /// work is; a screen that needs to open the work resolves through this.
  ///
  /// Every member keeps a row so that the gradebook, the CSV export, a student's own feedback
  /// page, and the Salesforce columns all go on reading one row per student. What they cost is
  /// that the reads answering "what is waiting on an instructor" have to know a mirror is not
  /// work, which is what `triageBucket`'s `mirrorsAnotherSubmission` is for.
  teamSubmissionId String? @map("team_submission_id") @db.Uuid

  /// Which member handed in the version now standing, rewritten on every hand-in.
  ///
  /// Any active member may hand in on their team's behalf, and doing so replaces what was there
  /// rather than adding a second submission — so "who handed this in" is a fact that changes
  /// while the row that holds the work does not. Null for work handed in before this column
  /// existed, and for a repository whose pull request was opened by an account matching no
  /// member of the team.
  handedInById String? @map("handed_in_by") @db.Uuid

  repoFullName              String? @unique @map("repo_full_name")
  repoUrl                   String? @map("repo_url")
  /// The GitHub login used when the repository was created. Preserved because a
  /// student can rename their GitHub account afterward, and the repository name
  /// does not change with them.
  repoGithubLoginAtCreation String? @map("repo_github_login_at_creation")

  prNumber     Int?    @map("pr_number")
  prUrl        String? @map("pr_url")
  /// Where the student's work is, when they handed it in as a link: their own copy of a
  /// Google Drive file, or whatever they made elsewhere. Null when they handed in a file
  /// instead — a path in a private bucket and a link to a document are not the same thing,
  /// and the review screen opens them differently, so the four columns below hold the stored
  /// file instead of this one pretending to.
  ///
  /// **Nulled when the same submission is handed in as a file**, because an assignment may
  /// accept both and a row carrying a link and a file is a row with two answers. Whichever
  /// method was used last is the one standing, and it is the only one recorded.
  submittedUrl String? @map("submitted_url")

  /// The uploaded file, when the work was handed in as one. All four are written
  /// together by the upload route or all four are null; there is no state where
  /// some of them mean anything on their own. Nulled when the same submission is
  /// later handed in as a link, for the reason `submittedUrl` above gives.
  ///
  /// `uploadPath` is the object's key inside the private bucket, and it is
  /// composed of this row's id and a generated name — never the filename the
  /// student chose, which is not something to build a path out of.
  /// `uploadFilename` keeps that name anyway, because it is what the instructor
  /// should see and what their browser should call the download.
  uploadPath        String?   @map("upload_path")
  uploadFilename    String?   @map("upload_filename")
  uploadSizeBytes   Int?      @map("upload_size_bytes")
  uploadContentType String?   @map("upload_content_type")
  headBranch        String?   @map("head_branch")
  headSha           String?   @map("head_sha")
  submittedAt       DateTime? @map("submitted_at") @db.Timestamptz(6)
  isLate            Boolean?  @map("is_late")
  lastActivityAt    DateTime? @map("last_activity_at") @db.Timestamptz(6)

  finalScore         Float?    @map("final_score")
  finalScorePossible Float?    @map("final_score_possible")
  isComplete         Boolean?  @map("is_complete")
  feedbackMarkdown   String?   @map("feedback_markdown")
  gradedById         String?   @map("graded_by") @db.Uuid
  gradedAt           DateTime? @map("graded_at") @db.Timestamptz(6)
  /// The commit the approved grade describes. `headSha != gradedHeadSha` means the
  /// student has pushed code newer than what was graded — a comparison of two
  /// columns, needing no API call and true the instant the push lands.
  gradedHeadSha      String?   @map("graded_head_sha")

  /// When the student said they had read the feedback they were given.
  ///
  /// **Read against `gradedAt` rather than merely checked for null**, which is what makes one
  /// column enough for a submission that is graded more than once. A student who reads their
  /// report, resubmits, and is graded again has this column already set, so a null check would
  /// call the second report read before it existed. `feedbackIsUnread` in `lib/status.ts` is
  /// that comparison, and it is the only thing that should ask this question.
  ///
  /// It gates nothing. Resubmitting does not require it and `assertCanHandIn` has never heard
  /// of it — it exists so a student can keep track of what they have been through, and so
  /// their dashboard can stop showing them a report they have read.
  feedbackReviewedAt DateTime? @map("feedback_reviewed_at") @db.Timestamptz(6)

  /// When an instructor last said the conversation about this work needs nothing from them.
  ///
  /// **Compared against the newest question rather than checked for null**, the same shape as
  /// `feedbackReviewedAt` above and for the same reason: a fellow who asks again after it was
  /// settled is waiting again, and a null check would keep the thread off the questions list
  /// forever. `awaitsReply` in lib/submissions/comments.ts is that comparison.
  ///
  /// **A property of the thread, not of one instructor.** Any instructor of the program may set it
  /// and it clears the row for all of them, which follows what `ProgramInstructor` already states:
  /// a co-teacher covering for somebody must be able to finish what they started.
  ///
  /// Replying is the other way a thread leaves that list, and the two do not interact — a reply
  /// makes the newest message an instructor's, which `awaitsReply` reads without consulting this.
  /// This column is for the questions needing no answer: handled in person, or worked out.
  ///
  /// On the row holding the work, like the comments themselves, so a team has one answer. Not
  /// among `MIRRORED_COLUMNS`: a mirror carries the grade and never the conversation.
  commentsResolvedAt   DateTime? @map("comments_resolved_at") @db.Timestamptz(6)
  commentsResolvedById String?   @map("comments_resolved_by") @db.Uuid

  /// Unused in this build. Present so the future Salesforce job can query
  /// `WHERE salesforce_sync_status = 'PENDING'` without needing a migration at
  /// that point. Nothing writes these columns yet.
  salesforceSyncStatus SalesforceSyncStatus @default(PENDING) @map("salesforce_sync_status")
  salesforceRecordId   String?              @map("salesforce_record_id")
  salesforceSyncedAt   DateTime?            @map("salesforce_synced_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignment         Assignment              @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student            Profile                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy           Profile?                @relation("GradedBy", fields: [gradedById], references: [id], onDelete: SetNull)
  commentsResolvedBy Profile?                @relation("CommentsResolved", fields: [commentsResolvedById], references: [id], onDelete: SetNull)
  handedInBy         Profile?                @relation("HandedInBy", fields: [handedInById], references: [id], onDelete: SetNull)
  team               Team?                   @relation(fields: [teamId, teamSetId], references: [id, teamSetId], onDelete: Restrict)
  /// `NoAction` rather than `Restrict`, and the difference matters: deleting an assignment
  /// cascades its submissions, and `RESTRICT` is checked per row rather than at the end of the
  /// statement, so it would refuse a cascade that is about to remove the mirror as well.
  /// **A constraint rather than a relation anybody reads.** It carries the foreign key holding a
  /// submission's team set to the one its own assignment is handed in by — which, together with
  /// the composite key on `team` above holding a team to its set, is what makes "graded as part
  /// of last term's teams" unrepresentable rather than merely unlikely.
  ///
  /// Declared here rather than left as hand-written SQL because a foreign key is something
  /// `migrate diff` *can* see: left out of the schema it would be proposed for removal on every
  /// future migration, and one day somebody would accept the proposal. Use `assignment` above.
  assignmentTeamSet  Assignment?             @relation("SubmissionTeamSet", fields: [assignmentId, teamSetId], references: [id, teamSetId], onDelete: Cascade, onUpdate: Cascade)
  teamSubmission     Submission?             @relation("TeamMirror", fields: [teamSubmissionId, assignmentId], references: [id, assignmentId], onDelete: NoAction, onUpdate: NoAction)
  mirrors            Submission[]            @relation("TeamMirror")
  gradingDrafts      GradingDraft[]
  testRuns           TestRun[]
  comments           SubmissionComment[]
  commentReads       SubmissionCommentRead[]

  @@unique([assignmentId, studentId])
  /// Redundant against the primary key, and bought so a mirror points at `(id, assignmentId)`
  /// together — which is what makes a mirror of a submission on some *other* assignment
  /// unrepresentable.
  @@unique([id, assignmentId])
  @@index([teamSubmissionId])
  @@index([teamId])
  @@map("submissions")
  @@schema("public")
}

// ===========================================================================
// Deterministic test execution
// ===========================================================================

enum TestRunStatus {
  RUNNING
  /// The suite ran to completion. Whether the student passed is testsFailed,
  /// not this — a completed run with failures is a successful run.
  COMPLETED
  TIMED_OUT
  /// Infrastructure failed: archive fetch, sandbox creation, extraction, the
  /// setup command, or result parsing. Never a zero score. Conflating this with
  /// COMPLETED is how a student gets a zero for a problem that is not theirs.
  ERRORED

  @@schema("public")
}

enum TestRunTrigger {
  MANUAL
  WEBHOOK

  @@schema("public")
}

/// One row per execution of an assignment's test suite against a student's code
/// at one commit. Rows are never updated in place after completion and reruns
/// append, so the history of a submission stays legible.
///
/// A submission with no rows at all is normal, not an error. Every assignment
/// whose runnerPreset is "none" has zero test runs forever, so nothing
/// downstream may read the absence of a row as a failure, a pending state, or a
/// zero. Three states are distinct:
///
///   no rows + runnerPreset "none"     — this assignment has no tests
///   no rows + any other preset        — tests exist and have not been run
///   COMPLETED row with testsFailed>0  — tests ran and failed
///
/// Separate from grading_drafts because results outlive any one draft:
/// re-generating a report against the same commit must not rerun the tests, and
/// the cross-check reads this table as its source of truth.
model TestRun {
  id           String         @id @default(uuid()) @db.Uuid
  submissionId String         @map("submission_id") @db.Uuid
  /// The student commit that was tested. Recorded rather than followed, so a
  /// push during the run cannot change what these results describe.
  headSha      String         @map("head_sha")
  trigger      TestRunTrigger @default(MANUAL)
  status       TestRunStatus  @default(RUNNING)

  runnerPreset      String  @map("runner_preset")
  e2bTemplate       String  @map("e2b_template")
  sandboxId         String? @map("sandbox_id")
  /// The template commit whose tests actually ran. Makes "these tests are newer
  /// than what the student was given" answerable after the fact.
  templateCommitSha String? @map("template_commit_sha")

  setupExitCode Int?   @map("setup_exit_code")
  testExitCode  Int?   @map("test_exit_code")
  testsTotal    Int?   @map("tests_total")
  testsPassed   Int?   @map("tests_passed")
  testsFailed   Int?   @map("tests_failed")
  testsSkipped  Int?   @map("tests_skipped")
  /// passed / total. NOT the score, and NOT compared against
  /// assignment.completionThreshold. Completion is judged on the final rubric
  /// score, of which test outcomes are one input among several: a submission
  /// that passes every test by returning hardcoded values has satisfied one
  /// criterion and should still lose points elsewhere.
  passRate      Float? @map("pass_rate")

  /// Per-test detail, one normalized shape for every runner:
  /// [{ suite, name, status, durationMs?, failureMessage? }]
  results       Json @default("[]")
  /// [{ path, kind: "added"|"modified"|"removed"|"renamed", previousPath? }] —
  /// protected paths the pull request changes, taken from the pull request's own
  /// diff and therefore measured against the template snapshot this student
  /// received. Non-empty is a finding an instructor must see, not an automatic
  /// penalty, and never affects passRate: the template's version of every
  /// protected path is restored before the suite runs.
  tamperedPaths Json @default("[]") @map("tampered_paths")

  /// Truncated. Whole suites can emit megabytes and nothing downstream reads
  /// past the first few thousand lines.
  stdoutTail  String? @map("stdout_tail")
  stderrTail  String? @map("stderr_tail")
  errorDetail String? @map("error_detail")

  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz(6)
  /// Wall clock for the whole run. An input to the Phase 4 orchestration
  /// decision, which turns on whether test execution alone already approaches a
  /// single function invocation's time limit.
  durationMs      Int?      @map("duration_ms")
  /// The setup command's share of durationMs, recorded separately because
  /// removing the install step is the largest speed improvement available and
  /// that decision needs numbers.
  setupDurationMs Int?      @map("setup_duration_ms")

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, headSha])
  @@map("test_runs")
  @@schema("public")
}

enum GradingDraftStatus {
  GENERATING
  READY
  NEEDS_MANUAL_REVIEW
  FAILED
  SUPERSEDED
  /// An instructor approved this draft and it became the student's grade. Terminal:
  /// the approved drafts of a submission, in order, are its feedback history.
  APPROVED

  @@schema("public")
}

enum Confidence {
  HIGH
  LOW

  @@schema("public")
}

/// One row per grading *run*, keyed by submission plus head SHA. A new push
/// creates a new row and marks the previous one SUPERSEDED rather than
/// overwriting it, so an instructor's in-progress review of an older run is
/// never silently replaced.
///
/// Written by the Phase 2 grading pipeline. Created here because Submission
/// relates to it and because the status values are what the instructor
/// interface will read.
model GradingDraft {
  id                String             @id @default(uuid()) @db.Uuid
  submissionId      String             @map("submission_id") @db.Uuid
  /// The commit this run describes, and null when the work has no commit — a hand-graded
  /// Google Doc or upload. Nullable rather than carrying a placeholder, because every
  /// reader of this column compares it against the submission's own `head_sha` to decide
  /// whether a draft has been overtaken, and a placeholder would have to be recognised as
  /// "not really a commit" at each of those comparisons. Null compares as "no commit to be
  /// out of date against", which is the truth.
  headSha           String?            @map("head_sha")
  status            GradingDraftStatus @default(GENERATING)
  errorDetail       String?            @map("error_detail")
  /// Model id, prompt version, grading-asset commit SHA, token usage.
  modelMetadata     Json?              @map("model_metadata")
  /// Set when an instructor approved this draft. Non-null here is what makes a draft
  /// part of the student's feedback history rather than a discarded proposal.
  approvedAt        DateTime?          @map("approved_at") @db.Timestamptz(6)
  approvedById      String?            @map("approved_by") @db.Uuid
  /// The pull request comment this approval posted.
  ///
  /// Recorded per draft, not per submission, because each approval posts its own
  /// comment and they accumulate: a student and an instructor can both read back
  /// through earlier rounds of feedback, which is the point of grading a resubmission
  /// rather than overwriting the first attempt.
  postedPrCommentId BigInt?            @map("posted_pr_comment_id")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  submission Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  approvedBy Profile?              @relation("ApprovedDrafts", fields: [approvedById], references: [id], onDelete: SetNull)
  sections   GradingDraftSection[]
  comments   SubmissionComment[]

  /// Redundant against the primary key, and bought so a comment can point at `(id, submissionId)`
  /// together — which is what makes a comment naming a round of some *other* submission
  /// unrepresentable. The same trick as `Submission.@@unique([id, assignmentId])`.
  @@unique([id, submissionId])
  @@index([submissionId, headSha])
  @@map("grading_drafts")
  @@schema("public")
}

/// Child rows of a GradingDraft — one submission can have more than one graded
/// section per run. The submission's final score on approval is the sum of a
/// run's section scores; the review interface renders each section separately.
model GradingDraftSection {
  id                    String      @id @default(uuid()) @db.Uuid
  gradingDraftId        String      @map("grading_draft_id") @db.Uuid
  sectionType           String      @map("section_type")
  reportMarkdown        String?     @map("report_markdown")
  scoreEarned           Float?      @map("score_earned")
  scorePossible         Float?      @map("score_possible")
  /// Per-criterion breakdown.
  rubricItems           Json        @default("[]") @map("rubric_items")
  /// Short codes only, e.g. ["MECHANICAL", "CLARITY"]. The review interface renders each
  /// one as a badge, so prose does not belong here — see instructorNotes.
  flags                 String[]    @default([])
  /// The model's caveats for the instructor, in prose. Never shown to the student:
  /// "the file I needed was absent", "this point value does not divide evenly into
  /// the checklist in the README".
  instructorNotes       String[]    @default([]) @map("instructor_notes")
  confidence            Confidence?
  /// The "you pushed to a non-draft branch" note that agent-rules.md already
  /// generates today.
  submissionProcessNote String?     @map("submission_process_note")

  /// An instructor's revision of the report, kept alongside the model's original
  /// rather than replacing it. Null until someone edits.
  ///
  /// Separate columns because overwriting `report_markdown` would destroy the only
  /// record of what the model actually produced — which is what any later judgment
  /// about whether the grading is good enough has to be made from. What gets posted
  /// is the edit where one exists; what gets evaluated is the pair.
  editedReportMarkdown String?   @map("edited_report_markdown")
  editedScoreEarned    Float?    @map("edited_score_earned")
  editedAt             DateTime? @map("edited_at") @db.Timestamptz(6)
  editedById           String?   @map("edited_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  gradingDraft GradingDraft @relation(fields: [gradingDraftId], references: [id], onDelete: Cascade)
  editedBy     Profile?     @relation("EditedSections", fields: [editedById], references: [id], onDelete: SetNull)

  @@map("grading_draft_sections")
  @@schema("public")
}

// ===========================================================================
// The conversation about a submission
// ===========================================================================

/// Which side of the conversation a comment came from, recorded when it was written.
///
/// A snapshot rather than a join to the author's `role`, which is mutable: a fellow later hired as
/// staff would otherwise turn every question they ever asked into an instructor's answer, emptying
/// the "waiting on a reply" list of the rows it exists to hold.
///
/// Two values where `Role` has three. ADMIN folds into INSTRUCTOR, because the only question any
/// reader asks is which of the two sides is waiting on the other.
enum SubmissionCommentAuthor {
  STUDENT
  INSTRUCTOR

  @@schema("public")
}

/// One message in the conversation about one piece of work.
///
/// **One thread per submission, and one per team where a team hands the work in.** The rows hang
/// off the submission that holds the work — the one with `team_submission_id IS NULL` — so every
/// active member reads and writes one conversation. `threadSubmissionId` in
/// lib/submissions/comments.ts is the resolution, and a trigger refuses a write that skipped it.
///
/// **A fellow may write before handing anything in**, which is half of what this is for. For the
/// kinds with no Accept there may be no submission row yet, so posting the first comment creates
/// one, `NOT_STARTED`, through `claimTeamWork`. Every reader downstream already treats that status
/// and "no row" as the same fact, so asking a question does not read as starting work.
///
/// In the application only. Nothing here is posted to or read from GitHub, which delivers grades.
///
/// One tolerated state: a member's row can become a mirror after they commented on it, when solo
/// work is later claimed by a team. The trigger fires on writes to this table rather than to
/// `submissions`, so that claim is not refused, and those comments resolve away rather than
/// reading wrong.
model SubmissionComment {
  id String @id @default(uuid()) @db.Uuid

  /// The row holding the work, never a mirror.
  submissionId String @map("submission_id") @db.Uuid

  /// `SetNull` for the reason `graded_by` is: an account going must not remove what somebody said
  /// from another person's conversation. The read path falls back to `authorRole`, which is why
  /// that column is NOT NULL and this one is not.
  authorId   String?                 @map("author_id") @db.Uuid
  authorRole SubmissionCommentAuthor @map("author_role")

  /// Which released round this is about, or null — which is every comment written before the work
  /// was first graded.
  ///
  /// Named by the writer rather than taken from the clock, because a fellow can answer round one's
  /// report after round two has gone out.
  ///
  /// The reference is composite, against `(id, submission_id)`, so a comment naming a round of
  /// another submission is unrepresentable. That the round is APPROVED is checked by the
  /// procedure, since a foreign key cannot read a status.
  ///
  /// `NoAction` rather than `SetNull` because a composite `SET NULL` would null `submission_id`
  /// too, and rather than `Restrict` because the only thing removing a draft is its submission
  /// going, which removes this row in the same statement.
  gradingDraftId String? @map("grading_draft_id") @db.Uuid

  /// Markdown, rendered through components/markdown.tsx, which runs no raw HTML.
  ///
  /// Capped both by `MAX_COMMENT_LENGTH` and by a CHECK, because a script does not run the
  /// application's code.
  body String

  /// When the author withdrew this.
  ///
  /// A tombstone rather than a removal: a reply answers the message above it, and closing up
  /// around a removed one leaves the reply answering whatever floats into its place.
  ///
  /// The author only, which is what keeps this to one column — no `deleted_by`, no paired CHECK,
  /// no audit event. The body stays in the column and `visibleBody` withholds it.
  ///
  /// There is no edit: editing rewrites what somebody already replied to.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  submission   Submission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author       Profile?      @relation("CommentsWritten", fields: [authorId], references: [id], onDelete: SetNull)
  gradingDraft GradingDraft? @relation(fields: [gradingDraftId, submissionId], references: [id, submissionId], onDelete: NoAction, onUpdate: NoAction)

  /// The thread read and the "who spoke last" read, which differ only in direction.
  @@index([submissionId, createdAt])
  /// How many this person has written lately, which is the ceiling the post procedure counts.
  @@index([authorId, createdAt])
  @@index([gradingDraftId])
  @@map("submission_comments")
  @@schema("public")
}

/// How far one fellow has read into one thread.
///
/// One row per reader per thread. `Submission.feedbackReviewedAt` is a single column because a
/// report has one reader; a thread a team shares has several, so the receipt moves off the
/// submission. Its shape does not change: a timestamp compared against each message's
/// `created_at`, never a boolean, which would have to be cleared by every write to the thread.
///
/// A per-comment table was the alternative and is the wrong size — it grows with messages times
/// readers, and the only question it answers that this cannot is one nobody asks about a
/// conversation read top to bottom.
///
/// A reader with no row has read nothing, so rows are written on first read rather than seeded.
///
/// **Only fellows write here.** Instructors get no unread count; their signal is the questions
/// list on the triage screen, which reads who spoke last.
model SubmissionCommentRead {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  lastReadAt   DateTime @map("last_read_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  profile    Profile    @relation("CommentReads", fields: [profileId], references: [id], onDelete: Cascade)

  /// One receipt per person per thread, which makes the write an upsert.
  @@unique([submissionId, profileId])
  @@index([profileId])
  @@map("submission_comment_reads")
  @@schema("public")
}

/// What an audit event records. One value per act worth being able to prove happened.
///
/// An enum rather than free text, because the point of this log is that the set of audited
/// acts is a decision somebody made and can review — a string column lets a new action be
/// introduced by a typo, and makes "which actions do we record?" a question you answer by
/// querying production data instead of by reading the schema.
enum AuditAction {
  /// Somebody's role was raised or lowered. The single most consequential act in the system.
  ROLE_CHANGED
  INVITE_CREATED
  /// Deleted before use. The row goes; this is what is left of it.
  INVITE_REVOKED
  INVITE_REDEEMED
  ROSTER_ENTRY_ADDED
  ROSTER_ENTRY_REMOVED
  ENROLLMENT_JOINED
  ENROLLMENT_REMOVED
  ENROLLMENT_RESTORED
  JOIN_TOKEN_REGENERATED
  /// A grade was released to a student, which is the act Salesforce will later mirror.
  GRADE_APPROVED

  /// The two operations that cost money — a model call and a sandbox — recorded so the ledger
  /// that answers "how many of these has this person just run" is the one already being written.
  /// See `lib/audit/rate-limit.ts` for why these live here rather than in a counter of their own.
  DRAFT_GENERATED
  TESTS_RUN
  /// An admin began looking at the application as a test student.
  ///
  /// **There is deliberately no matching VIEW_AS_EXITED.** The view is held by a session cookie
  /// with no lifetime, so closing the browser leaves it without any request being made — an exit
  /// event would be absent far more often than it was present, and an event whose absence means
  /// nothing is worse than no event, because a reader will draw a conclusion from it anyway.
  /// What bounds a view is the `acted_as` columns on the events written during it.
  VIEW_AS_ENTERED
  /// Created and deleted through the Supabase service role key, which bypasses every policy.
  TEST_STUDENT_CREATED
  TEST_STUDENT_DELETED

  /// Attendance, which is the second thing in this log — after a released grade — that somebody
  /// outside the school is eventually shown. A stipend is defended on these rows, so the question
  /// they have to answer is not "who was here" but "who said so, and when".
  ATTENDANCE_SESSION_STARTED
  ATTENDANCE_SESSION_UPDATED
  /// Its own value rather than an UPDATED carrying a flag. Putting a closed session back into
  /// check-in is the act somebody asks about afterwards, and it should be findable without
  /// reading the detail of every edit.
  ATTENDANCE_SESSION_REOPENED
  ATTENDANCE_SESSION_ENDED
  ATTENDANCE_SESSION_DELETED
  ATTENDANCE_CODE_ROTATED
  /// One per fellow per session. "Prove this fellow checked themselves in on 14 September" is the
  /// question a funder asks, and the record row alone stops being able to answer it the moment an
  /// instructor is allowed to edit one.
  ATTENDANCE_CHECKED_IN
  ATTENDANCE_STATUS_SET
  /// A wrong code. Here rather than in a counter of its own for the reason `DRAFT_GENERATED` is —
  /// see `lib/audit/rate-limit.ts` — and because "somebody tried four hundred codes" is a question
  /// worth being able to answer at all.
  ATTENDANCE_CHECK_IN_FAILED

  @@schema("public")
}

/// An append-only record of the acts that decide who can see whose work.
///
/// **Why this table exists.** Every guard in `trpc/init.ts` answers "may this person do this?"
/// and none of them answers "who did this, and when?". Those are different questions, and the
/// second is the one asked after something has gone wrong — a grade nobody remembers changing,
/// a student who says they never joined a cohort, an instructor account that should not have
/// been staff. Without a record the answer is a reconstruction from mutable rows.
///
/// **No foreign keys, deliberately, and this is the whole design.** A key would give exactly
/// one of two behaviours when the row it points at is deleted, and both destroy the record:
/// `Cascade` removes the event, and `SetNull` rewrites it — which the append-only trigger on
/// this table would refuse anyway, deadlocking an ordinary profile deletion. So the columns
/// below hold plain uuids alongside a **text snapshot of who or what they were at the time**.
/// A deleted test student leaves an event that still says which admin created it and what it
/// was called. That is the property an audit log has to have: it outlives its subjects.
///
/// The snapshots are also what makes the log readable without joining four tables, and what
/// makes it correct when a person changes their display name after the fact.
model AuditEvent {
  id         String      @id @default(uuid()) @db.Uuid
  occurredAt DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)
  action     AuditAction

  /// **The real signed-in user, never the impersonated one.**
  ///
  /// `createTRPCContext` substitutes a test student's id onto `ctx.user` while an admin is in
  /// a view-as session, so an event written from `ctx.user.id` would name the test student as
  /// the actor — attributing an admin's act to an identity that cannot perform it. The context
  /// carries `actorId` separately for this reason; see `lib/audit/record.ts`.
  ///
  /// Nullable for acts with no signed-in actor. Nothing writes one today, and a NOT NULL here
  /// would mean a future system-initiated event — a scheduled sync, a webhook — had to invent
  /// an actor to be recordable.
  actorId    String? @map("actor_id") @db.Uuid
  /// Display name or email as it read when the event was written.
  actorLabel String? @map("actor_label")

  /// The test student the actor was viewing as, when they were. Null in the ordinary case.
  ///
  /// Present so a reader can tell an admin acting as themselves from the same admin acting
  /// inside a preview — which changes what the event means without changing who did it.
  actedAsId    String? @map("acted_as_id") @db.Uuid
  actedAsLabel String? @map("acted_as_label")

  /// Who or what was acted upon: a profile, an enrollment, an invitation, a submission.
  ///
  /// Untyped on purpose. The subjects are heterogeneous and a column per kind would be mostly
  /// nulls; `action` already says which table to look in, and `subjectLabel` says what it was
  /// without looking at all.
  subjectId    String? @map("subject_id") @db.Uuid
  subjectLabel String? @map("subject_label")

  /// The program this happened in, where it happened in one — which is most acts, since enrollment,
  /// the roster, cohorts, and attendance all belong to a program now.
  programId    String? @map("program_id") @db.Uuid
  programLabel String? @map("program_label")

  /// The course this happened in, for the acts that are about one: a released grade, an assignment
  /// published, a course archived. **Both pairs exist rather than one replacing the other**, because
  /// "which program was this" and "which course was this" are different questions and a
  /// released grade is the only thing in this log that answers the second.
  courseId    String? @map("course_id") @db.Uuid
  courseLabel String? @map("course_label")

  /// Everything else, shaped per action: the roles either side of a change, the score
  /// released, the reason a refusal was recorded. Read by people, not by queries.
  detail Json?

  @@index([occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([programId, occurredAt(sort: Desc)])
  @@index([courseId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@map("audit_events")
  @@schema("public")
}

/// Somebody expected in a program, recorded before they ever sign in.
///
/// **The allowlist half of joining.** A join link is unguessable but not private: whoever runs the
/// program sends it however they already talk to their fellows, which means into a group chat, an
/// email thread, or a message somebody forwards. Without this table the link would be the whole
/// credential and the controls would all be after the fact: replace the link, remove whoever got in.
/// This makes the link necessary and not sufficient. Holding it admits nobody who is not already
/// expected by name.
///
/// **One roster for the whole program**, which is one of the duplications the program removes: the
/// same list of expected people used to be entered once per course.
///
/// **Matched on GitHub login or email, either one.** Two keys rather than one because each fails in a
/// way the other covers. Somebody who renames their GitHub account between the roster being entered
/// and their first sign-in no longer matches by login; somebody whose GitHub email is private
/// presents a `users.noreply.github.com` address and never matched by email to begin with. Requiring
/// one and accepting either is what makes the roster survive contact with real accounts. Both are
/// stored lowercased — GitHub logins are case-insensitive, and the handle the signup trigger
/// captures preserves whatever casing GitHub had.
///
/// **One entry admits one person, once.** `claimedById` is set in the same transaction as the
/// enrollment, so a second person who somehow matched the same entry finds it taken. A fellow who is
/// removed and later restored still matches their own claimed entry, which is why the check is
/// "unclaimed, or claimed by you" rather than "unclaimed".
model RosterEntry {
  id        String @id @default(uuid()) @db.Uuid
  programId String @map("program_id") @db.Uuid

  /// GitHub login, lowercased. Null when whoever entered it only had an address.
  githubUsername String? @map("github_username")
  /// Email, lowercased. Null when they only had a handle.
  email          String?

  /// Who this is meant to be, in an instructor's words. Not matched on — it exists so a roster of
  /// unclaimed entries reads as a list of people rather than a list of handles, which is what makes a
  /// typo in one of the two keys above findable.
  note String?

  /// The profile that matched this entry and joined on it. Null until somebody does.
  claimedById String?   @map("claimed_by_id") @db.Uuid
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(6)

  addedById String?  @map("added_by_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  claimedBy Profile? @relation("RosterClaimed", fields: [claimedById], references: [id], onDelete: SetNull)
  addedBy   Profile? @relation("RosterAdded", fields: [addedById], references: [id], onDelete: SetNull)

  /// One entry per person per program, on whichever key was given. Two entries naming the same
  /// fellow by different keys would each admit them once, which is one enrollment and two claimed
  /// rows — harmless, and confusing enough on the screen to be worth preventing at the point of entry
  /// rather than here.
  @@unique([programId, githubUsername])
  @@unique([programId, email])
  @@index([programId])
  @@map("roster_entries")
  @@schema("public")
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  /// An absence with a reason. **It still counts as missed** — the note explains the miss rather
  /// than removing it, which keeps one denominator and one rate that nobody has to interpret
  /// before quoting it to a funder.
  EXCUSED

  @@schema("public")
}

/// How a record came to exist, which is a different question from what it says.
///
/// The three are told apart because the sentence a fellow is owed differs at each: "you checked
/// yourself in at 9:04", "your instructor marked you excused", and "nobody checked you in and the
/// session ended". Collapsing the third into the second turns an absence into an accusation, and
/// it is also the distinction a compliance reader needs — a stipend day defended on a fellow's own
/// check-in is a different claim from one defended on a staff correction.
enum AttendanceSource {
  SELF_CHECK_IN
  INSTRUCTOR
  /// Written when a session ends, never by a person, and always ABSENT.
  FINALIZED

  @@schema("public")
}

/// One day of one program, on one civil date.
///
/// **A program day rather than a course meeting**, which is the change this whole layer exists for. A
/// fellow takes several courses inside one program and arrives at the building once, so there
/// is one session to check into and one code to type. Before the program existed, `Course` was the
/// only cohort-shaped thing in the schema and a fellow in three courses had three of each.
///
/// **The smallest calendar that works, and still deliberately not a calendar.** There is no term, no
/// timetable, and no notion of which days a program is supposed to meet. A session exists because an
/// instructor pressed start. That has a consequence worth writing down rather than discovering: **a
/// morning nobody opened is indistinguishable from a morning the program did not meet.** Nothing here
/// can detect a forgotten Tuesday, and nothing tries: without term dates a warning would fire on
/// Saturdays and over winter break, and a warning wrong twice a week is one people stop seeing. The
/// denominator is sessions that happened, which is also the more honest figure — a forgotten morning
/// should not read as a program-wide absence.
///
/// **`date` is a civil date and not an instant**, and it is the only `@db.Date` in this schema
/// besides `gcf_attempts.taken_on`. The unique constraint below is the whole reason: two instructors
/// pressing start at 9:00 and 9:01 must collide, and they only collide if the key is the *day* rather
/// than a timestamp that happens to fall inside it. A timestamptz holding "midnight in New York" is
/// unique only if every writer computes that instant identically, and a caller who used UTC midnight,
/// a caller who used the current time, and a daylight-saving boundary each produce a second row for
/// the same day while the constraint sits there satisfied. See `lib/school-time.ts` for the
/// conversion — and never send this column to a browser as a `Date`, because Prisma hands it back as
/// UTC midnight and a reader in Brooklyn renders it as the day before.
model AttendanceSession {
  id        String   @id @default(uuid()) @db.Uuid
  programId String   @map("program_id") @db.Uuid
  date      DateTime @db.Date

  /// When check-in opened. Also what lateness is measured from, which is why editing it after the
  /// fact recomputes every self check-in's status.
  startedAt   DateTime @map("started_at") @db.Timestamptz(6)
  startedById String?  @map("started_by_id") @db.Uuid

  /// When the code stops working on its own. `startedAt + 90 minutes` at first, pushed forward half
  /// an hour at a time by Extend.
  ///
  /// **Two columns for ending, because they answer different questions.** This one is when the code
  /// dies; `endedAt` is when a person said the day was over. A session is open while `endedAt` is
  /// null *and* now is before this — so the backstop needs nothing to run at the ninety-minute mark,
  /// which matters because there is no scheduler in this project and no prospect of one. It is a
  /// comparison, like every other time rule here.
  ///
  /// Without it, a session nobody ended keeps a working code alive until the next day, and a fellow
  /// could mark themselves present at eight in the evening for a nine o'clock morning. The sweep in
  /// `start` closes the books eventually; this is what stops the code before it does.
  endsAt DateTime @map("ends_at") @db.Timestamptz(6)

  /// Set when a person ended the session. Null until then, including after the backstop has lapsed —
  /// collapsing the two would mean either the backstop overwrote a person's decision or a person's
  /// decision looked like a timeout, and the log could no longer tell them apart.
  endedAt DateTime? @map("ended_at") @db.Timestamptz(6)

  /// Copied from `Program.attendanceLateAfterMinutes` when the session starts.
  ///
  /// **Copied rather than read through**, and that is the point of the column existing twice. A
  /// stored status decided against a live setting would let somebody loosen the rule in November and
  /// silently convert a term of LATEs into PRESENTs, so no report would agree with any report printed
  /// before it. Copying is what makes the program's setting editable at all.
  lateAfterMinutes Int @map("late_after_minutes")

  /// The HMAC key the check-in code derives from. 64 hex characters, 256 bits, random per session.
  ///
  /// **On the row rather than in the environment**, for reasons that are all operational: it survives
  /// a deploy, so a restart at 9:03 does not lock a program out; two instructor screens derive the
  /// same code because neither holds state; a code that leaks is worthless tomorrow without anybody
  /// doing anything; and rotating after a leak is a button rather than a deploy.
  ///
  /// **Never selected into a payload.** The same rule as `Program.joinToken` and sharper — that one
  /// admits somebody to a roster, this one lets them mark themselves present from bed. Only
  /// `lib/attendance/code.ts` reads it.
  codeSecret String @map("code_secret")

  /// Free text about the day — "guest speaker", "half day". Not matched on.
  note String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  program   Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  startedBy Profile?           @relation("AttendanceStarted", fields: [startedById], references: [id], onDelete: SetNull)
  records   AttendanceRecord[]

  /// **What makes starting a day idempotent.** Two instructors pressing the button in the same minute
  /// produce one session, and the loser of the race is handed the one that exists rather than a
  /// second one with a different code. A program that ever meets twice in a day needs a third column
  /// here; nothing else in the design changes.
  @@unique([programId, date])
  @@index([programId, date(sort: Desc)])
  @@map("attendance_sessions")
  @@schema("public")
}

/// What one fellow did on one program day.
///
/// **Keyed on the enrollment**, because the enrollment is what says "a fellow *of this program*" —
/// the thing attendance is actually about. And because removal is a status rather than a deleted row,
/// a fellow who leaves in week 4 and is restored in week 7 keeps one enrollment and therefore one
/// continuous history.
///
/// **The enrollment relation is composite on purpose.** `setStatus` takes an enrollment id from
/// input, and pointing at `(enrollmentId, programId)` together is what makes an instructor of one
/// program writing a record against another program's fellow unrepresentable rather than merely
/// refused by the procedure. `programId` is copied from the session the server just loaded, never
/// taken from input, and it pays for itself twice — the compliance export reads one table instead of
/// joining through the session to ask which program a row belongs to.
///
/// **`@@unique([sessionId, enrollmentId])` is what makes checking in twice harmless.** A fellow who
/// types the code, sees nothing happen, and types it again gets the record they already have:
/// `checkIn` returns it rather than refusing, and writes no second audit event. It is the same
/// constraint that makes ending a session idempotent, since the insert skips duplicates and this
/// decides who already had a row.
///
/// **A self check-in only ever creates, never updates.** That is the rule that stops a fellow
/// overwriting an EXCUSED their instructor set for them by typing a code they overheard.
///
/// `checkedInAt` survives an override, so an instructor calling a 9:07 arrival PRESENT leaves a row
/// saying both the time they arrived and the decision made about it. That is what turns correcting a
/// session somebody started five minutes early into a recomputation rather than a guess — and it is
/// also what the arrival averages in `lib/attendance/arrival.ts` are computed from.
model AttendanceRecord {
  id           String @id @default(uuid()) @db.Uuid
  sessionId    String @map("session_id") @db.Uuid
  programId    String @map("program_id") @db.Uuid
  enrollmentId String @map("enrollment_id") @db.Uuid

  status AttendanceStatus
  source AttendanceSource

  /// When the fellow submitted a valid code. Null on a row no fellow created.
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(6)

  /// The instructor who set or overrode this. Null on a self check-in and on a finalized absence.
  /// SetNull rather than Cascade, for the reason `InstructorInvite.redeemedBy` is: deleting the
  /// person must not delete the record of what they decided.
  recordedById String? @map("recorded_by_id") @db.Uuid

  /// Why, in words. The whole of what EXCUSED means is in here, and it is also where a fellow's own
  /// account of a missed morning ends up once an instructor acts on it.
  note String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session    AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollment Enrollment        @relation(fields: [enrollmentId, programId], references: [id, programId], onDelete: Cascade)
  recordedBy Profile?          @relation("AttendanceRecorded", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, enrollmentId])
  @@index([enrollmentId])
  @@index([programId, status])
  @@map("attendance_records")
  @@schema("public")
}

// =====================================================================================
// The General Coding Framework
//
// An assessment CodeSignal administers, outside this application entirely. A fellow sits a
// proctored one that produces a scaled score shared with employers, and practises against mocks
// beforehand. It is deliberately **not** modelled as coursework: there is no assignment, no
// submission, nothing handed in, and nothing to grade. A result is a number that arrives from
// somewhere else, so what is stored is a record of an attempt rather than a piece of work.
//
// Both tables are keyed on the *person* rather than an enrollment, and carry no course. A GCF
// result follows a fellow through the program — CodeSignal has no idea what a cohort is — which
// is why a student reads their whole history on one page and the gradebook's tab finds attempts
// by joining on the students enrolled in that course.
// =====================================================================================

/// Which assessment an attempt was, which is `Proctoring Status` in CodeSignal's export.
///
/// The discriminator is that column and only that column: it says `Proctoring verified` or
/// `Not proctored` in words, which is readable in the export by eye and cannot be confused with
/// a number that has to be interpreted. Which score column carries the result then follows —
/// see `score` below.
enum GcfKind {
  /// The real thing, sat under proctoring. Its result is a scaled Assessment Score in the
  /// 200–600 band: normalized and psychometrically calibrated, blending correctness, speed, and
  /// question weight, and it is the figure shared with employers.
  PROCTORED

  /// A mock, sat for practice. Its result is raw test-case correctness — 300 points per task,
  /// before any penalty or speed scaling — so it is a different quantity from the one above and
  /// the two are never compared or averaged together.
  MOCK

  @@schema("public")
}

/// One attempt at the GCF by one fellow.
model GcfAttempt {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid

  kind GcfKind

  /// The result, on the scale its `kind` implies.
  ///
  /// A proctored attempt reports CodeSignal's `Assessment Score` and no maximum; a mock reports
  /// `Score` against a `Max Score`. The export never fills both, which is what makes reading the
  /// wrong column a defect worth reporting rather than a case to handle.
  score Int

  /// What it was out of, from `Max Score`.
  ///
  /// Null on a proctored attempt, which reports no maximum — its scale is the 200–600 band, and
  /// that is knowledge about the assessment rather than data in the file.
  ///
  /// On the row rather than derived from `kind`, because it is **not constant**: a mock is 300
  /// points per task over one, three, four, or six tasks, so a real export carries 300, 900,
  /// 1200, and 1800 in the same column.
  scorePossible Int? @map("score_possible")

  /// The day it was sat.
  ///
  /// A date rather than a timestamp, because the day is what identifies an attempt — see the
  /// unique below — and because an attempt typed in by hand has no time of day to record.
  takenOn DateTime @map("taken_on") @db.Date

  /// CodeSignal's `Session ID`, so a row can be traced back to the export it came from.
  ///
  /// Null on an attempt typed in by hand. **Deliberately not the key**: an import has to merge
  /// with a score somebody already entered for that day rather than sit beside it as a second
  /// record of one attempt, and a key CodeSignal owns cannot do that.
  externalId String? @map("external_id")

  /// CodeSignal's own page for the result, for an instructor who wants the detail behind a score.
  resultUrl String? @map("result_url")

  /// CodeSignal's `Integrity Flagged`. Common enough to matter: 56 of 274 rows in a real export.
  integrityFlagged Boolean @default(false) @map("integrity_flagged")

  /// Why, in words — and the whole of what a flag means to the fellow reading it.
  ///
  /// Written by an instructor and **shown to the student**, which is the point of it existing. A
  /// flag with no account of itself appearing on somebody's record, with nobody to ask, is worse
  /// than not showing the flag at all; this is what turns it into something they can raise.
  note String?

  /// The instructor who entered or last edited this. Null on a row an import wrote untouched.
  /// SetNull rather than Cascade, for the reason `AttendanceRecord.recordedById` is: deleting the
  /// person must not delete the record of what they entered.
  recordedById String? @map("recorded_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    Profile  @relation("GcfAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy Profile? @relation("GcfRecorded", fields: [recordedById], references: [id], onDelete: SetNull)

  /// A fellow, a kind, and a day is what identifies an attempt.
  ///
  /// True of real data — the 74 GCF rows of a term's export produce 74 distinct triples — and it
  /// is what makes an import idempotent *and* able to fill in a score somebody typed by hand for
  /// the same day, which keying on CodeSignal's session id could not do.
  @@unique([studentId, kind, takenOn])
  @@index([studentId, takenOn])
  @@map("gcf_attempts")
  @@schema("public")
}

/// An address a fellow sits the GCF under, for the times it is not the one they log in with.
///
/// A fellow signs up to CodeSignal with the address they use for GitHub, so most rows in an
/// export match a profile without help. This table is what the rest need: an instructor resolves
/// an unmatched row once during an import, and the address is remembered so the next upload
/// matches it without being asked.
///
/// Its own table rather than a column on `Profile`, because somebody can sit under more than one
/// address over nine months and a single column would make the second overwrite the first.
model GcfIdentity {
  id String @id @default(uuid()) @db.Uuid

  /// Lowercased on the way in, so matching is a lookup rather than a scan over every row.
  email     String @unique
  studentId String @map("student_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student Profile @relation("GcfIdentities", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("gcf_identities")
  @@schema("public")
}
